# Keep PATH entries unique (.zprofile also adds some)
typeset -U path

# Using Starship
eval "$(starship init zsh)"

# Setup Locale Lang
export LANG=en_US.UTF-8

# history setup
HISTFILE=$HOME/.zhistory
HISTSIZE=60000
SAVEHIST=50000
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_verify

source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# zsh-autocomplete runs compinit itself and binds the Up/Down arrow keys.
# It saves recent dirs here but never creates the directory.
mkdir -p ${XDG_DATA_HOME:-$HOME/.local/share}/zsh
source $HOMEBREW_PREFIX/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh

alias eza="eza --color=auto --icons=auto"

eval "$(zoxide init zsh)"

alias code="open -b com.microsoft.VSCode"
alias gitgraph="git log --oneline --graph --decorate --all"
alias kvim='NVIM_APPNAME="nvim-kickstart" nvim'

# Array form so typeset -U drops duplicates (export PATH=... does not)
path=(
  $HOME/.local/bin
  $HOMEBREW_PREFIX/opt/rustup/bin
  ${GOPATH:-$HOME/go}/bin
  $path
)

# mise tool versions; activate after other PATH edits so its tools come first
command -v mise &>/dev/null && eval "$(mise activate zsh)"

# 1Password SSH agent, only where 1Password is running its agent
op_sock=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
[[ -S $op_sock ]] && export SSH_AUTH_SOCK=$op_sock
unset op_sock

# Machine-only settings (work git identities, secrets); not tracked by chezmoi
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Must be sourced last, after every other widget is defined
source $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
