# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
# if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
#   source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
# fi
#
# source /usr/local/share/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
# [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Using Starship
eval "$(starship init zsh)"

# Setup Locale Lang
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# history setup
HISTFILE=$HOME/.zhistory
SAVEHIST=1000
HISTSIZE=999
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify



bindkey "^[[A" history-search-backward
bindkey "^[[B" history-search-forward
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# zsh-autocomplete runs compinit itself; add extra completions to FPATH before it loads
FPATH=$HOMEBREW_PREFIX/share/zsh-completions:$FPATH
source /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

alias eza="eza --color=always --icons=always"

eval "$(zoxide init zsh)"

alias code="open -b com.microsoft.VSCode"
alias arm="env /usr/bin/arch -arm64 /bin/zsh --login"
alias intel="env /usr/bin/arch -x86_64 /bin/zsh --login"
alias killdocker="pkill -SIGHUP -f /Applications/Docker.app 'docker serve'"
alias gitgraph="git log --oneline --graph --decorate --all"
alias tmuxs="$HOME/setup_tmux_session.sh"
alias kvim='NVIM_APPNAME="kickstart.nvim" nvim'
alias mvim='NVIM_APPNAME="mewvim" nvim'

export NVM_DIR="$HOME/.nvm"
  [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
  [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

export PATH="/opt/homebrew/opt/bison/bin:$PATH"

[[ -s "$HOME/.gvm/scripts/gvm" ]] && source "$HOME/.gvm/scripts/gvm"

export PATH="$(go env GOPATH)/bin:$PATH"
export PATH="/opt/homebrew/opt/unzip/bin:$PATH"
export PATH="/opt/homebrew/opt/rustup/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# 1Password SSH agent, only where 1Password is running its agent
op_sock=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
[[ -S $op_sock ]] && export SSH_AUTH_SOCK=$op_sock
unset op_sock

# Machine-only settings (work git identities, secrets); not tracked by chezmoi
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
