{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(rtk ls *)",
      "Bash(rtk cat *)",
      "Bash(rtk grep *)",
      "Bash(rtk git status)",
      "Bash(rtk git diff *)",
      "Bash(rtk git log *)",
      "Bash(rtk go test *)",
      "Bash(rtk docker ps *)",
      "Read(**/.env.example)",
      "Edit(**/.env.example)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.production)",
      "Edit(**/.env.production)",
      "Read(**/.env.staging)",
      "Edit(**/.env.staging)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/*service-account*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
{{- $herdrHook := joinPath .chezmoi.homeDir ".claude/hooks/herdr-agent-state.sh" }}
{{- if stat $herdrHook }},
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ $herdrHook }}' session",
            "timeout": 10
          }
        ]
      }
    ]
{{- end }}
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "caveman@caveman": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "figma@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "testcontainers-claude-skills": {
      "source": {
        "source": "github",
        "repo": "testcontainers/claude-skills"
      }
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 900000,
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
{{- /* Machine-only autoMode rules live outside the repo; see README */}}
{{- $autoMode := joinPath .chezmoi.homeDir ".config/chezmoi/claude-automode.json" }}
{{- if stat $autoMode }}
  "autoMode": {{ include $autoMode | trim }},
{{- end }}
  "feedbackSurveyState": {
    "lastShownTime": 1754319921121
  }
}
