{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(rtk ls *)",
      "Bash(rtk cat *)",
      "Bash(rtk grep *)",
      "Bash(rtk git status)",
      "Bash(rtk git diff *)",
      "Bash(rtk git log *)",
      "Bash(rtk go test *)",
      "Bash(rtk docker ps *)",
      "Read(**/.env.example)",
      "Write(**/.env.example)"
    ],
    "deny": [
      "Read(**/.env)",
      "Write(**/.env)",
      "Read(**/.env.production)",
      "Write(**/.env.production)",
      "Read(**/.env.staging)",
      "Write(**/.env.staging)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/*service-account*.json)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.claude/sounds/decision.mp3"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.claude/sounds/decision.mp3"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "caveman@caveman": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "figma@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "testcontainers-claude-skills": {
      "source": {
        "source": "github",
        "repo": "testcontainers/claude-skills"
      }
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754319921121
  }
}
